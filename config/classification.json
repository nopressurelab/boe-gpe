      "title": 1.0,
      "summary": 0.6,
      "department": 0.8,
      "section": 0.3,
      "subsection": 0.3
    },
    "normalize": {
      "lowercase": true,
      "strip_accents": true,
      "collapse_whitespace": true
    },
    "count_repeats": false,
    "topic_fields": [
      "title",
      "summary",
      "section",
      "subsection"
    ],
    "_comment_topic_fields": "Fields the topic terms score on. The issuing body (department) is deliberately left out: its name signals environmental remit and is scored under 'boosts', but it must not assign a topic nor be enough on its own."
