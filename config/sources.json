      "adapter": "rss",
      "options": {
        "urls": [
          "https://doe.juntaex.es/rss/rss.php?seccion=1",
          "https://doe.juntaex.es/rss/rss.php?seccion=2",
          "https://doe.juntaex.es/rss/rss.php?seccion=3",
          "https://doe.juntaex.es/rss/rss.php?seccion=4",
          "https://doe.juntaex.es/rss/rss.php?seccion=5"
        ],
        "encoding": "iso-8859-1",
        "strip_html": true,
        "section_from_category": true,
        "use_channel_date_as_fallback": true,
        "field_patterns": [
          {
            "from": "summary",
            "pattern": "^\\s*(?P<department>[^.]+?)\\s*\\.\\s*(?P<subsection>[^.]+?)\\s*\\.-"
          }
        ]
      }
    },
