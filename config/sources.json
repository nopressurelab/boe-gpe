{
  "_comment": "Every source is configured here; there are no URLs in the code. To add a gazette, copy an entry and adjust 'adapter' and 'options'. Available adapters: boe_sumario, rss, opendatasoft. The 'notes' fields are rendered on the public site, so they stay in Spanish.",
  "defaults": {
    "user_agent": "boletines-ambientales/1.0 (+https://github.com/nopressurelab/boe-gpe)",
    "timeout_seconds": 45,
    "retries": 3,
    "retry_backoff_seconds": 4,
    "lookback_days": 4
  },
  "sources": [
    {
      "id": "boe",
      "name": "Boletín Oficial del Estado",
      "short_name": "BOE",
      "scope": "estatal",
      "region": "España",
      "region_code": "ES",
      "language": "es",
      "homepage": "https://www.boe.es/",
      "enabled": true,
      "adapter": "boe_sumario",
      "options": {
        "url_template": "https://boe.es/datosabiertos/api/boe/sumario/{yyyymmdd}",
        "accept": "application/json",
        "url_field": "url_html",
        "pdf_field": "url_pdf",
        "skip_section_codes": []
      }
    },
    {
      "id": "dog",
      "name": "Diario Oficial de Galicia",
      "short_name": "DOG",
      "scope": "autonomica",
      "region": "Galicia",
      "region_code": "GA",
      "language": "es",
      "homepage": "https://www.xunta.gal/diario-oficial-galicia",
      "enabled": true,
      "adapter": "rss",
      "options": {
        "urls": [
          "https://www.xunta.gal/diario-oficial-galicia/rss/Sumario_es.rss"
        ],
        "use_channel_date_as_fallback": true,
        "strip_html": true,
        "skip_title_patterns": [
          "^\\s*Sumario\\s*$"
        ],
        "field_patterns": [
          {
            "from": "summary_raw",
            "pattern": "^\\s*(?P<section>.*?)\\s*</br>\\s*(?P<department>.*?)\\s*$",
            "flags": "is"
          }
        ]
      }
    },
    {
      "id": "boc-canarias",
      "name": "Boletín Oficial de Canarias",
      "short_name": "BOC Canarias",
      "scope": "autonomica",
      "region": "Canarias",
      "region_code": "CN",
      "language": "es",
      "homepage": "https://www.gobiernodecanarias.org/boc/",
      "enabled": true,
      "adapter": "rss",
      "options": {
        "urls": [
          "https://www.gobiernodecanarias.org/boc/feeds/capitulo/disposiciones_generales.rss",
          "https://www.gobiernodecanarias.org/boc/feeds/capitulo/otras_resoluciones.rss",
          "https://www.gobiernodecanarias.org/boc/feeds/capitulo/anuncios.rss"
        ],
        "use_channel_date_as_fallback": true,
        "strip_html": true,
        "field_patterns": [
          {
            "from": "channel_title",
            "pattern": "^(?:RSS\\s+)?(?P<section>.+?)\\s*$"
          },
          {
            "from": "summary",
            "pattern": "^[^-]*-\\s*(?P<department>[^0-9]+?)\\s*(?:\\d|$)"
          }
        ]
      }
    },
    {
      "id": "doe",
      "name": "Diario Oficial de Extremadura",
      "short_name": "DOE",
      "scope": "autonomica",
      "region": "Extremadura",
      "region_code": "EX",
